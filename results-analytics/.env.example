# Leave both variables unset to use this project's local/Vercel API function.
#
# Set these only after deploying your own JNTUH backend. The backend URL must
# not end with /api. Vite embeds VITE_* values in the browser bundle, so this
# API key is a public gateway value, not a private secret.
# VITE_RESULTS_BACKEND_URL=https://jntuh-api.example.com
# VITE_RESULTS_BACKEND_API_KEY=replace-with-your-backend-api-access-key
